PORT=3000
HOST=127.0.0.1
# Optional. Placeholder or short values are ignored.
# On first boot the panel writes .jwt-access and .jwt-refresh (mode 600) in the data directory.
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# Set to 1 when the panel is served over HTTPS so the access cookie is marked Secure.
# COOKIE_SECURE=
# Comma-free single origin if a separate dev UI must call the API. Leave unset in production.
# CORS_ORIGIN=
ENCRYPTION_KEY_PATH=/etc/xhttp-panel/.encryption-key
DB_PATH=./data/panel.db
INSTALLER_ENV_PATH=/etc/xhttp-installer/info.env
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
